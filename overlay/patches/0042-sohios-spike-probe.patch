Overlay patch 0042 (D25): SPIKE ATTRIBUTION PROBE. Port of Shipwright-ios
0066 (D-085) to Starship's LUS fork (Kenix3 1.3.1-350: src/graphic/Fast3D,
src/resource, src/public/bridge). The SoH-only seams (actor/object/room
spawn, the GetPixelDepth depth readback and its pipeline -- Starship never
calls GetPixelDepth, D26) are dropped; SoH 0019's upload ledger has no
Starship equivalent, so texture upload time stays inside `tex`.

WHAT IT MEASURES. Every 2D engine frame is cut at 0041's pace seams (drawable
acquired / LUS sleep begins) plus three marks inside
Fast3dWindow::DrawAndRunGraphicsCommands; the record closes right after
Interpreter::EndFrame (post-sleep):
  gap    previous frame's post-sleep -> this frame's drawable request. Holds
         the game tick on the first frame of each tick (logic), the audio
         hand-off wait (aud), SDL_PumpEvents = every UIKit main-thread
         callback (ev), FrameInterpolation_Interpolate (interp).
  wait   nextDrawable (0041).
  busy   drawable -> LUS sleep (0041), split into
           menu  ImGui NewFrame + DrawMenu + CalculateGameViewport
           run   Interpreter::StartFrame + Run (the display list)
           gui   Gui::EndDraw (DrawGame, ImGui render, floating windows)
           end   Interpreter::EndFrame up to the pacing sleep
  cpu    gap + busy; a frame whose cpu exceeds the frame period
         (1000 / interpolation fps) is a SPIKE.
Seam categories (game thread = the main thread on iOS):
   0 res    resource cache MISS loaded on the game thread (n/ms/bytes + the 3
            largest by name)       1 rd   the archive read part of res
   2 bg     cache misses loaded on the resource pool threads
   3 rwait  ResourceManager::LoadResource on the game thread (hits + waits)
   4 tex    Interpreter::ImportTexture (decode + upload of a new texture)
   5 shd    CreateAndLoadNewShader on the game thread
   6 fbrd   ReadFramebufferToCPU   7 cvsave CVarSave
   8 aud    EndAudioFrame waiting on the audio thread
   9 ev     wnd->HandleEvents (SDL pump: touches, timers, the 0.25 s poll)
  10 interp FrameInterpolation_Interpolate
plus per-frame triangles / vertices / draw calls.

OUTPUT. SOH_SPIKE (one line per spike frame, max 20 per 10 s) and
SOH_SPKWIN (one line per 10 s: frames, spikes, cpu p50/p95/max, per-frame
average of each split over all / spike frames, each category's
n / total ms / ms inside spikes). gSohIos.SpikeProbe (default 1, re-read
every 60 frames) switches it off for the probe-cost A/B.

Code: new file src/port/SohIosSpike.cpp (source of truth:
overlay/assets/probe/). Vendor hunks are call sites only and keep clear of
earlier patches' hunks + contexts. Generate against 0001..0041 applied.

--- /dev/null
+++ b/src/port/SohIosSpike.cpp
@@ -0,0 +1,321 @@
+// SOH_IOS (overlay 0042, D25): SPIKE ATTRIBUTION PROBE. Port of Shipwright
+// 0066 (D-085) to Starship -- see the patch header for the split and the
+// categories. Game-thread state (the game loop owns the main thread on iOS),
+// except the resource pool threads' ledger, which is mutex-guarded. Reads
+// 0041's pace timestamps (SohIosPace.h) for the drawable/sleep seams.
+#ifdef __IOS__
+#include "SohIosPace.h"
+
+#include <algorithm>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <libultraship.h>
+#include <spdlog/spdlog.h>
+
+extern "C" {
+volatile int gSohIosSpkOn = 1;
+unsigned int gSohIosSpkTris = 0;
+unsigned int gSohIosSpkVtx = 0;
+unsigned int gSohIosSpkDraws = 0;
+}
+
+namespace SohIosSpk {
+using SohIosPace::Clock;
+using SohIosPace::Ms;
+using SohIosPace::Set;
+enum { NCAT = 11 };
+static const char* const kName[NCAT] = { "res", "rd", "bg", "rwait", "tex", "shd",
+                                         "fbrd", "cvsave", "aud", "ev", "interp" };
+enum { S_GAP, S_WAIT, S_BUSY, S_LOGIC, S_MENU, S_RUN, S_GUI, S_END, NSPLIT };
+static const char* const kSplit[NSPLIT] = { "gap", "wait", "busy", "logic", "menu", "run", "gui", "end" };
+struct Top {
+    char name[60];
+    float ms;
+    unsigned kb;
+};
+struct Frame {
+    unsigned long long t[NCAT];
+    unsigned n[NCAT];
+    unsigned long long b[NCAT];
+    Top top[3];
+};
+struct Win {
+    double ms[NCAT];
+    double spk[NCAT];
+    unsigned long long n[NCAT];
+    unsigned long long b[NCAT];
+    double split[NSPLIT];
+    double splitSpk[NSPLIT];
+    unsigned frames, spikes, logged;
+    unsigned long long tris, vtx, draws;
+    unsigned trisMax, drawsMax;
+    double cpu[4096];
+    unsigned ncpu;
+    Clock::time_point start;
+};
+static Frame sF{};
+static Frame sBg{}; // pool-thread loads since the last frame end (sBgMu)
+static std::mutex sBgMu;
+static Win sW{};
+static Clock::time_point sFrameStart{}, sTickExit{}, sMark[3]{};
+static double sLogicMs = 0.0;
+static int sTickFrame = 0;
+
+static double TickMs() {
+    static const double v = [] {
+        mach_timebase_info_data_t tb;
+        mach_timebase_info(&tb);
+        return (double)tb.numer / (double)tb.denom / 1e6;
+    }();
+    return v;
+}
+
+static void TopInsert(Top* top, const char* name, float ms, unsigned kb) {
+    int lo = 0;
+    for (int i = 1; i < 3; i++) {
+        if (top[i].ms < top[lo].ms) {
+            lo = i;
+        }
+    }
+    if (ms <= top[lo].ms) {
+        return;
+    }
+    size_t len = name ? strlen(name) : 0;
+    const char* src = (len > sizeof(top[lo].name) - 1) ? name + (len - (sizeof(top[lo].name) - 1)) : name;
+    snprintf(top[lo].name, sizeof(top[lo].name), "%s", src ? src : "?");
+    top[lo].ms = ms;
+    top[lo].kb = kb;
+}
+
+// Bounded append into a fixed line buffer (no allocation).
+static void Ap(char* buf, size_t cap, size_t& k, const char* fmt, ...) __attribute__((format(printf, 4, 5)));
+static void Ap(char* buf, size_t cap, size_t& k, const char* fmt, ...) {
+    if (k >= cap - 1) {
+        return;
+    }
+    va_list ap;
+    va_start(ap, fmt);
+    int w = vsnprintf(buf + k, cap - k, fmt, ap);
+    va_end(ap);
+    if (w > 0) {
+        k = std::min(cap - 1, k + (size_t)w);
+    }
+}
+
+static void AppendTops(char* buf, size_t cap, size_t& k, const Top* top, const char* prefix) {
+    for (int i = 0; i < 3; i++) {
+        if (top[i].ms > 0.0f) {
+            Ap(buf, cap, k, " %s%s:%.1fms:%ukb", prefix, top[i].name, top[i].ms, top[i].kb);
+        }
+    }
+}
+
+static void ReportWindow(Clock::time_point now) {
+    Win& w = sW;
+    double el = Ms(w.start, now) / 1000.0;
+    if (w.frames > 0) {
+        std::sort(w.cpu, w.cpu + w.ncpu);
+        auto pct = [&](double p) { return w.ncpu ? w.cpu[(size_t)(p * (w.ncpu - 1))] : 0.0; };
+        static char buf[2048];
+        size_t k = 0;
+        Ap(buf, sizeof(buf), k, "SOH_SPKWIN el=%.1f frames=%u spikes=%u logged=%u cpu_ms p50=%.2f p95=%.2f max=%.2f |",
+           el, w.frames, w.spikes, w.logged, pct(0.5), pct(0.95), w.ncpu ? w.cpu[w.ncpu - 1] : 0.0);
+        Ap(buf, sizeof(buf), k, " avg_ms all/spike:");
+        for (int s = 0; s < NSPLIT; s++) {
+            Ap(buf, sizeof(buf), k, " %s=%.2f/%.2f", kSplit[s], w.split[s] / w.frames,
+               w.spikes ? w.splitSpk[s] / w.spikes : 0.0);
+        }
+        Ap(buf, sizeof(buf), k, " | n/ms/spk_ms:");
+        for (int c = 0; c < NCAT; c++) {
+            if (w.n[c] == 0) {
+                continue;
+            }
+            Ap(buf, sizeof(buf), k, " %s=%llu/%.1f/%.1f", kName[c], w.n[c], w.ms[c], w.spk[c]);
+            if (w.b[c] != 0) {
+                Ap(buf, sizeof(buf), k, "/%.1fMB", w.b[c] / 1048576.0);
+            }
+        }
+        Ap(buf, sizeof(buf), k, " | tris_avg=%llu tris_max=%u vtx_avg=%llu draws_avg=%llu draws_max=%u thermal=%d",
+           w.tris / w.frames, w.trisMax, w.vtx / w.frames, w.draws / w.frames, w.drawsMax, SohIos_ThermalState());
+        SPDLOG_INFO("{}", buf);
+    }
+    sW = Win{};
+    sW.start = now;
+}
+} // namespace SohIosSpk
+
+extern "C" unsigned long long SohIos_SpkNow(void) {
+    return gSohIosSpkOn ? mach_absolute_time() : 0ull;
+}
+
+extern "C" void SohIos_SpkAdd(int cat, unsigned long long t0, unsigned long long bytes) {
+    if (t0 == 0ull || cat < 0 || cat >= SohIosSpk::NCAT || !pthread_main_np()) {
+        return;
+    }
+    SohIosSpk::sF.t[cat] += mach_absolute_time() - t0;
+    SohIosSpk::sF.n[cat]++;
+    SohIosSpk::sF.b[cat] += bytes;
+}
+
+// A resource cache miss that was actually loaded (ResourceManager). Any thread.
+extern "C" void SohIos_SpkRes(const char* name, unsigned long long t0, unsigned long long tRead,
+                              unsigned long long bytes) {
+    using namespace SohIosSpk;
+    if (t0 == 0ull) {
+        return;
+    }
+    unsigned long long now = mach_absolute_time();
+    float ms = (float)((now - t0) * TickMs());
+    if (pthread_main_np()) {
+        sF.t[0] += now - t0;
+        sF.n[0]++;
+        sF.b[0] += bytes;
+        sF.t[1] += tRead - t0;
+        sF.n[1]++;
+        TopInsert(sF.top, name, ms, (unsigned)(bytes / 1024));
+    } else {
+        std::lock_guard<std::mutex> lk(sBgMu);
+        sBg.t[2] += now - t0;
+        sBg.n[2]++;
+        sBg.b[2] += bytes;
+        TopInsert(sBg.top, name, ms, (unsigned)(bytes / 1024));
+    }
+}
+
+// 0/1/2: StartDraw / Run / EndDraw returned. 3: RunCommands entry (the game
+// tick has just run). 4: EndAudioFrame's audio wait done (tick exit).
+extern "C" void SohIos_SpkMark(int which) {
+    using namespace SohIosSpk;
+    if (!gSohIosSpkOn) {
+        return;
+    }
+    auto now = Clock::now();
+    if (which >= 0 && which < 3) {
+        sMark[which] = now;
+    } else if (which == 3) {
+        sLogicMs = Set(sTickExit) ? Ms(sTickExit, now) : 0.0;
+        sTickFrame = 0;
+    } else if (which == 4) {
+        sTickExit = now;
+    }
+}
+
+// Closes one 2D frame record. Called by Fast3dWindow right after
+// Interpreter::EndFrame (so after LUS's pacing sleep).
+extern "C" void SohIos_SpkFrameEnd(void) {
+    using namespace SohIosSpk;
+    static unsigned sPoll = 0;
+    if ((sPoll++ % 60u) == 0u) {
+        int on = CVarGetInteger("gSohIos.SpikeProbe", 1) != 0 ? 1 : 0;
+        if (on != gSohIosSpkOn) {
+            gSohIosSpkOn = on;
+            SPDLOG_INFO("SOH_SPKWIN probe -> {}", on);
+            sF = Frame{};
+            sFrameStart = Clock::time_point{};
+            sTickExit = Clock::time_point{};
+            ReportWindow(Clock::now());
+        }
+    }
+    if (!gSohIosSpkOn) {
+        gSohIosSpkTris = gSohIosSpkVtx = gSohIosSpkDraws = 0;
+        return;
+    }
+    auto now = Clock::now();
+    if (!Set(sW.start)) {
+        sW.start = now;
+    }
+    const auto db = SohIosPace::gDrawBegin, de = SohIosPace::gDrawEnd, sb = SohIosPace::gSleepBegin;
+    bool ok = Set(sFrameStart) && db >= sFrameStart && de >= db && sb >= de && sb <= now && gSoh3DMode == 0;
+    double gap = ok ? Ms(sFrameStart, db) : 0.0;
+    if (ok && gap < 500.0) {
+        double sp[NSPLIT] = {};
+        sp[S_GAP] = gap;
+        sp[S_WAIT] = Ms(db, de);
+        sp[S_BUSY] = Ms(de, sb);
+        sp[S_LOGIC] = sLogicMs;
+        if (sMark[0] >= de && sMark[1] >= sMark[0] && sMark[2] >= sMark[1] && sb >= sMark[2]) {
+            sp[S_MENU] = Ms(de, sMark[0]);
+            sp[S_RUN] = Ms(sMark[0], sMark[1]);
+            sp[S_GUI] = Ms(sMark[1], sMark[2]);
+            sp[S_END] = Ms(sMark[2], sb);
+        }
+        Top bgTop[3] = {};
+        {
+            std::lock_guard<std::mutex> lk(sBgMu);
+            sF.t[2] = sBg.t[2];
+            sF.n[2] = sBg.n[2];
+            sF.b[2] = sBg.b[2];
+            memcpy(bgTop, sBg.top, sizeof(bgTop));
+            sBg = Frame{};
+        }
+        double cpu = sp[S_GAP] + sp[S_BUSY];
+        double period = 1000.0 / (double)std::max(SohIosPace::gFps, 20);
+        bool spike = cpu > period;
+        Win& w = sW;
+        w.frames++;
+        if (w.ncpu < 4096) {
+            w.cpu[w.ncpu++] = cpu;
+        }
+        for (int s = 0; s < NSPLIT; s++) {
+            w.split[s] += sp[s];
+            if (spike) {
+                w.splitSpk[s] += sp[s];
+            }
+        }
+        for (int c = 0; c < NCAT; c++) {
+            double ms = sF.t[c] * TickMs();
+            w.ms[c] += ms;
+            w.n[c] += sF.n[c];
+            w.b[c] += sF.b[c];
+            if (spike) {
+                w.spk[c] += ms;
+            }
+        }
+        w.tris += gSohIosSpkTris;
+        w.vtx += gSohIosSpkVtx;
+        w.draws += gSohIosSpkDraws;
+        w.trisMax = std::max(w.trisMax, gSohIosSpkTris);
+        w.drawsMax = std::max(w.drawsMax, gSohIosSpkDraws);
+        if (spike) {
+            w.spikes++;
+            if (w.logged < 20) {
+                w.logged++;
+                static char buf[1536];
+                size_t k = 0;
+                Ap(buf, sizeof(buf), k,
+                   "SOH_SPIKE cpu=%.1f period=%.1f fi=%d gap=%.1f wait=%.1f busy=%.1f logic=%.1f menu=%.1f run=%.1f "
+                   "gui=%.1f end=%.1f tris=%u vtx=%u draws=%u |",
+                   cpu, period, sTickFrame, sp[S_GAP], sp[S_WAIT], sp[S_BUSY], sp[S_LOGIC], sp[S_MENU], sp[S_RUN],
+                   sp[S_GUI], sp[S_END], gSohIosSpkTris, gSohIosSpkVtx, gSohIosSpkDraws);
+                for (int c = 0; c < NCAT; c++) {
+                    if (sF.n[c] == 0) {
+                        continue;
+                    }
+                    Ap(buf, sizeof(buf), k, " %s=%u/%.2f", kName[c], sF.n[c], sF.t[c] * TickMs());
+                    if (sF.b[c] != 0) {
+                        Ap(buf, sizeof(buf), k, "/%llukb", sF.b[c] / 1024);
+                    }
+                }
+                Ap(buf, sizeof(buf), k, " | top:");
+                AppendTops(buf, sizeof(buf), k, sF.top, "");
+                AppendTops(buf, sizeof(buf), k, bgTop, "bg:");
+                SPDLOG_INFO("{}", buf);
+            }
+        }
+    }
+    sF = Frame{};
+    gSohIosSpkTris = gSohIosSpkVtx = gSohIosSpkDraws = 0;
+    sLogicMs = 0.0;
+    sTickFrame++;
+    // Re-read the clock: the probe's own logging is not charged to the next
+    // frame (SOH_PACE, which is independent, still sees it).
+    sFrameStart = Clock::now();
+    if (Ms(sW.start, sFrameStart) >= 10000.0) {
+        ReportWindow(sFrameStart);
+    }
+}
+#endif
